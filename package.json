{
  "name": "mi-tune",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "vite build && node scripts/build-sw.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "setup:music": "python -m venv .venv && .venv/bin/python -m pip install -r requirements.txt"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "framer-motion": "14.10.1",
    "jose": "^6.2.15",
    "lenis": "^1.3.27",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react-swc": "4.3.3",
    "axe-core": "^4.14.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.6"
  }
}
